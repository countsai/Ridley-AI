<Application x:Class="Ridley.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#16181D"/>
        <SolidColorBrush x:Key="Panel" Color="#1F232B"/>
        <SolidColorBrush x:Key="PanelAlt" Color="#272C36"/>
        <SolidColorBrush x:Key="Fg" Color="#E8EAF0"/>
        <SolidColorBrush x:Key="FgDim" Color="#9AA3B5"/>
        <SolidColorBrush x:Key="Accent" Color="#5B8CFF"/>
        <SolidColorBrush x:Key="Danger" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="Warn" Color="#F5B342"/>
        <SolidColorBrush x:Key="Ok" Color="#4CC38A"/>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="#3A4150"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="#3A4150"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>

