<Window x:Class="Ridley.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Ridley.App.ViewModels"
        xmlns:core="clr-namespace:Ridley.Core;assembly=Ridley.Core"
        xmlns:svc="clr-namespace:Ridley.App.Services"
        Title="Ridley" Width="400" Height="600" MinWidth="320" MinHeight="420"
        Topmost="{Binding AlwaysOnTop}" Background="{StaticResource Bg}"
        Foreground="{StaticResource Fg}" FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="Manual" ShowInTaskbar="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <svc:NullToVisibilityConverter x:Key="NullToVis"/>
        <Style x:Key="StateDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="{StaticResource Ok}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:AssistantState.Listening}">
                    <Setter Property="Fill" Value="{StaticResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:AssistantState.Processing}">
                    <Setter Property="Fill" Value="{StaticResource Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:AssistantState.Speaking}">
                    <Setter Property="Fill" Value="#B48CFF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:AssistantState.Error}">
                    <Setter Property="Fill" Value="{StaticResource Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Bubble" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="User">
                    <Setter Property="Background" Value="#2A3E6B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Error">
                    <Setter Property="Background" Value="#4A2327"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="System">
                    <Setter Property="Background" Value="Transparent"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: state + settings -->
        <DockPanel Grid.Row="0" Margin="14,12,14,8" LastChildFill="False">
            <Ellipse Style="{StaticResource StateDot}" DockPanel.Dock="Left" AutomationProperties.AutomationId="StateIndicator"/>
            <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" AutomationProperties.AutomationId="StatusText"/>
            <Button Content="Settings" DockPanel.Dock="Right" Command="{Binding ToggleSettingsCommand}"
                    AutomationProperties.AutomationId="SettingsButton"/>
        </DockPanel>

        <!-- Screen capture status: visible only while pixels are being read -->
        <Border Grid.Row="1" Background="#5A2A2A" Padding="14,6" Margin="0,0,0,6"
                Visibility="{Binding Capture.IsCapturing, Converter={StaticResource BoolToVis}}"
                AutomationProperties.AutomationId="CaptureBadge">
            <TextBlock Text="{Binding Capture.Description, StringFormat='â— Screen capture active: {0}'}" TextWrapping="Wrap" FontSize="12"/>
        </Border>

        <!-- Error banner -->
        <Border Grid.Row="2" Background="#4A2327" Padding="14,6" Margin="0,0,0,6"
                Visibility="{Binding ErrorBanner, Converter={StaticResource NullToVis}}"
                AutomationProperties.AutomationId="ErrorBanner">
            <DockPanel>
                <Button Content="Dismiss" DockPanel.Dock="Right" Command="{Binding DismissErrorCommand}" Padding="8,2"/>
                <TextBlock Text="{Binding ErrorBanner}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Conversation -->
        <ScrollViewer Grid.Row="3" x:Name="MessageScroller" VerticalScrollBarVisibility="Auto" Margin="14,0">
            <ItemsControl ItemsSource="{Binding Messages}" AutomationProperties.AutomationId="Conversation">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChatMessage}">
                        <Border Style="{StaticResource Bubble}">
                            <StackPanel>
                                <TextBlock Text="{Binding Author}" FontSize="11" Foreground="{StaticResource FgDim}"/>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input row -->
        <Grid Grid.Row="4" Margin="14,8,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Mic" IsEnabled="{Binding VoiceAvailable}" ToolTip="{Binding MicrophoneToolTip}"
                    Margin="0,0,6,0" AutomationProperties.AutomationId="MicButton"/>
            <TextBox Grid.Column="1" x:Name="InputBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="False" AutomationProperties.AutomationId="InputBox">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SubmitCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="2" Content="Send" Command="{Binding SubmitCommand}" Margin="6,0,0,0"
                    Background="{StaticResource Accent}" AutomationProperties.AutomationId="SendButton"/>
            <Button Grid.Column="3" Content="Stop" Command="{Binding StopCommand}" Margin="6,0,0,0"
                    AutomationProperties.AutomationId="StopButton"/>
        </Grid>

        <!-- Settings panel (covers the conversation) -->
        <Border Grid.Row="2" Grid.RowSpan="3" Background="{StaticResource Bg}" Padding="14,4,14,14"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}"
                AutomationProperties.AutomationId="SettingsPanel">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding Settings}">
                    <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="Push-to-talk hotkey" Foreground="{StaticResource FgDim}"/>
                    <TextBox Text="{Binding PushToTalkHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"
                             AutomationProperties.AutomationId="HotkeyBox"/>
                    <TextBlock Text="Saved now; the hotkey itself becomes active in Phase 2." FontSize="11"
                               Foreground="{StaticResource FgDim}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <CheckBox Content="Keep Ridley on top" IsChecked="{Binding AlwaysOnTop}"/>
                    <CheckBox Content="Minimise to the system tray when closed" IsChecked="{Binding MinimiseToTray}"/>
                    <CheckBox Content="Teaching overlay enabled" IsChecked="{Binding OverlayEnabled}"/>
                    <CheckBox Content="Allow screen capture when I ask for it" IsChecked="{Binding AllowScreenCapture}"
                              AutomationProperties.AutomationId="AllowCaptureBox"/>
                    <TextBlock Text="Off by default. Ridley only captures on request and shows a badge while it does."
                               FontSize="11" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" Margin="20,0,0,6"/>
                    <CheckBox Content="Speak responses aloud" IsChecked="{Binding SpeakResponses}"/>
                    <TextBlock Text="Retries per failed step" Foreground="{StaticResource FgDim}" Margin="0,8,0,0"/>
                    <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.RetryChoices}" SelectedItem="{Binding MaxRetriesPerStep}"/>
                    <TextBlock Text="Log level" Foreground="{StaticResource FgDim}"/>
                    <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.LogLevels}" SelectedItem="{Binding LogLevel}"/>
                    <TextBlock Text="{Binding ProviderStatus}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FgDim}" Margin="0,6,0,6"/>
                    <TextBlock Text="Actions that send, delete, buy or otherwise have consequences always ask for your approval. This cannot be turned off."
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FgDim}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="SettingsValidation"/>
                    <TextBlock Text="{Binding SavedMessage}" Foreground="{StaticResource Ok}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="SettingsSaved"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Save" Command="{Binding SaveCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="SaveSettings"/>
                        <Button Content="Reset to defaults" Command="{Binding ResetToDefaultsCommand}" Margin="0,0,8,0"/>
                        <Button Content="Close" Command="{Binding DataContext.ToggleSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>


