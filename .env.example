# Copy to .env for local development. .env is git-ignored. Never commit real values.
# Nothing here is required to launch Ridley; unset providers are reported as "not configured".

# --- Model provider (any OpenAI-compatible endpoint, e.g. local Ollama / LM Studio) ---
RIDLEY__Model__Provider=openai-compatible
RIDLEY__Model__BaseUrl=http://localhost:11434/v1
RIDLEY__Model__Model=
RIDLEY__Model__ApiKey=

# --- Speech ---
RIDLEY__Stt__Provider=whisper-local
RIDLEY__Stt__ModelPath=
RIDLEY__Tts__Provider=windows

# --- Behaviour ---
RIDLEY__PushToTalkHotkey=Ctrl+Alt+Space
# Mocks are for tests/dev only and are always labelled MOCK in the UI.
RIDLEY__AllowMocks=false
RIDLEY__LogLevel=Information

# --- OceanToken gateway (spike). Prefer storing the key in Ridley's DPAPI store; this env var overrides it. ---
RIDLEY__OceanToken__ApiKey=
